# Copy to .env.local and paste a real key from https://console.anthropic.com
#
# No NEXT_PUBLIC_ prefix, deliberately: that prefix is what bundles a variable
# into the JavaScript the browser downloads. Without it, this value is only ever
# visible to server-side code (Route Handlers) and never reaches the client.
#
# This file is a TEMPLATE and is NOT gitignored - it is meant to be committed.
# Never put a real key here. The real key belongs in .env.local, which is.
ANTHROPIC_API_KEY=sk-ant-...

# --- Persistence (Module 22). Optional. -------------------------------------
#
# Leave both blank and the app keeps the in-memory stores from Modules 12, 19
# and 20 and behaves exactly as it did before Module 22. Fill them in and the
# usage log, rate-limit buckets, conversations and Claude's memory move to
# Postgres.
#
# From your Supabase project: Project Settings -> API.
#
# Note what is NOT here: no NEXT_PUBLIC_ prefix on either value, for the same
# reason as above. Plenty of Supabase tutorials ship NEXT_PUBLIC_SUPABASE_URL
# and a publishable key, because their app queries the database from the
# browser. This one never does - every query runs in a Route Handler - so
# neither value has any business being in the bundle.
#
# SUPABASE_SECRET_KEY is the SECRET key (sb_secret_..., or service_role on an
# older project), not the publishable/anon one. It bypasses row-level security
# completely. Treat it exactly like the Anthropic key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# What the app refuses to spend past, per UTC day. Default 5.
SPEND_CEILING_USD=
